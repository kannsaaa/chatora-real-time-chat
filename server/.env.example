# MongoDB Connection URI (e.g., local MongoDB or MongoDB Atlas connection string)
DB=mongodb://127.0.0.1:27017/chatapp

# JWT Private Key for signing auth tokens
JWTPRIVATEKEY=your_jwt_private_key_here

# Password hashing salt rounds (default: 10)
SALT=10

# Server port (Render will automatically set PORT in production)
PORT=4000

# Frontend URL (Used for generating email verification links and CORS origin verification)
# Development: http://localhost:5173
# Production (Render Frontend): https://chatora-u7yz.onrender.com
# IMPORTANT: On your Render Backend Web Service settings, set FRONTEND_URL and BASE_URL to your frontend static site URL:
# FRONTEND_URL=https://chatora-u7yz.onrender.com
# BASE_URL=https://chatora-u7yz.onrender.com
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:5173

# Resend Email Delivery Configuration (HTTPS API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Sender email address
# For testing without a custom domain, you can use: onboarding@resend.dev
# In production with a verified domain, use your domain address: e.g. Chatora <verify@yourdomain.com>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Node Environment ('development' or 'production')
NODE_ENV=development
