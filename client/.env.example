# Chatora Frontend Environment Variables
# ======================================
# Backend API Base URL
# Development: http://localhost:4000
# Production (Render Backend): https://chatora-real-time-chat.onrender.com
VITE_API_URL=http://localhost:4000

# Backend WebSocket URL
# Development: ws://localhost:4000
# Production (Render WebSocket): wss://chatora-real-time-chat.onrender.com
VITE_WS_URL=ws://localhost:4000
